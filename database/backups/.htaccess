# Dievon — backups hold full database dumps (customer names, addresses, orders).
# Serving them over HTTP would hand the whole shop to anyone with the URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
