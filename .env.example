# Public address of the shop, used for images and links inside emails.
# Needed because config.php treats CLI as "local", so mail sent from a cron job
# on the live server would otherwise embed http://localhost:8888/... and the
# logo would not load for the recipient. Leave blank during local development.
SITE_PUBLIC_URL=https://dievon.com
